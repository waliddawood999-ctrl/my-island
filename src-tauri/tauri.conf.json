{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyIsland",
  "version": "0.1.0",
  "identifier": "app.myisland.desktop",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": {
    "windows": [
      { "label": "main", "url": "index.html", "width": 760, "height": 560, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "shadow": false, "focus": false, "x": 0, "y": 0 },
      { "label": "overlay", "url": "overlay.html", "decorations": false, "shadow": false, "resizable": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis"], "category": "Productivity", "createUpdaterArtifacts": true },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/waliddawood999-ctrl/my-island-releases/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NzdFN0ZGQjJBREZGNkQKUldSdC82MnkvK2QzbUNxL1dsUTQ4SVoxMHBkUEc0a3NITm9RTHdsZy83LzNpNjVZRUJLaTBWQVQK",
      "windows": { "installMode": "passive" }
    }
  }
}
